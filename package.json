{
  "name": "launcher",
  "version": "1.0.3",
  "description": "Launcher para Talisman Online",
  "author": "Elton Sousa",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.talisman.launcher",
    "productName": "Talisman launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    }
  },
  "dependencies": {
    "axios": "^1.14.0",
    "core-util-is": "^1.0.3",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  }
}
